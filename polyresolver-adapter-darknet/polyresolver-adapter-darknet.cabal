name:                polyresolver-adapter-darknet
version:             0.1.0.0
synopsis:            darknet adapter for polyresolver
description:         darknet adapter implementation
homepage:            https://github.com/polyresolver/polyresolver
license:             MIT
author:              polyresolver team
maintainer:          team@polyresolver.dev
category:            Network
cabal-version:       >= 1.2
build-type:          Simple

library
  exposed-modules:     Polyresolver.Adapter.Darknet
  build-depends:       base, polyresolver-types, polyresolver-core, network >= 3.1 && < 3.3, bytestring, text, containers, mtl, dns
  hs-source-dirs:      src
  default-language:    Haskell2010
