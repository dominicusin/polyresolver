name:                polyresolver-adapter-hsd
version:             0.1.0.0
synopsis:            hsd adapter for polyresolver
description:         hsd adapter implementation
homepage:            https://github.com/polyresolver/polyresolver
license:             MIT
author:              polyresolver team
maintainer:          team@polyresolver.dev
category:            Network
cabal-version:       >= 1.2
build-type:          Simple

library
  exposed-modules:     Polyresolver.Adapter.Hsd
  build-depends:       base, polyresolver-types, polyresolver-core, dns, network >= 3.1 && < 3.3, bytestring, text, containers, mtl, binary, iproute, async, exceptions, http-client, http-client-tls, aeson
  hs-source-dirs:      src
  default-language:    Haskell2010
