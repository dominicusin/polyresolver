cabal-version: 2.4
name: polyresolver-core
version: 0.1.0.0
synopsis: Routing engine, STM cache and supervisor tree for polyresolver
description:
  The core of polyresolver: namespace routing with the one-namespace-one-
  authoritative-adapter invariant, a sharded STM cache with negative caching
  and singleflight deduplication, an Erlang/OTP-style supervisor tree over
  lightweight GHC threads, and the resolution engine that ties them together
  with delegation and cycle detection (ТРЕБ-001/002/003/012/018/020).
license: MPL-2.0
license-file: LICENSE
maintainer: polyresolver@nousresearch.com
category: Network
build-type: Simple
extra-source-files:
  CHANGELOG.md
  README.md

library
  exposed-modules:
    Polyresolver.Core
    Polyresolver.Core.Routing
    Polyresolver.Core.Cache
    Polyresolver.Core.Supervisor
    Polyresolver.Core.Engine
    Polyresolver.Core.Adapter
  hs-source-dirs: src
  default-language: Haskell2010
  build-depends:
      base         >= 4.15 && < 5
    , polyresolver-types
    , async        >= 2.2  && < 2.3
    , containers   >= 0.6  && < 0.8
    , exceptions   >= 0.10 && < 0.11
    , hashable     >= 1.4  && < 1.5
    , mtl          >= 2.3  && < 2.4
    , stm          >= 2.5  && < 2.6
    , text         >= 2.0  && < 2.2
    , time         >= 1.11 && < 1.14
    , unordered-containers >= 0.2 && < 0.3
    , vector       >= 0.13 && < 0.14
  ghc-options:
    -Wall
    -Wcompat
    -Wmissing-export-lists
    -Worphans

test-suite polyresolver-core-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  other-modules:
    Polyresolver.Core.Test.Adapters
  default-language: Haskell2010
  build-depends:
      base
    , polyresolver-types
    , polyresolver-core
    , hspec          >= 2.10 && < 2.12
    , hspec-hedgehog >= 0.1  && < 0.2
    , hedgehog       >= 1.2  && < 1.5
    , stm
    , text
    , time
  ghc-options: -Wall -threaded -rtsopts -with-rtsopts=-N
