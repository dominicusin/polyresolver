name:                polyresolver-server
version:             0.1.0.0
synopsis:            Main polyresolver server
description:         DNS, API, and metrics server
homepage:            https://github.com/polyresolver/polyresolver
license:             MIT
author:              polyresolver team
maintainer:          team@polyresolver.dev
category:            Network
cabal-version:       >= 1.2
build-type:          Simple

executable polyresolver-server
  main-is:             Main.hs
  build-depends:       base, polyresolver-types, polyresolver-core, polyresolver-dns, polyresolver-api, polyresolver-metrics, polyresolver-config, polyresolver-ctl, text, network, warp >= 3.3 && < 3.4, wai >= 3.2 && < 3.3, http-types, async, stm
  hs-source-dirs:      src
  default-language:    Haskell2010
