name:                polyresolver-adapter-decentweb
version:             0.1.0.0
synopsis:            decentweb adapter for polyresolver
description:         decentweb adapter implementation
homepage:            https://github.com/polyresolver/polyresolver
license:             MIT
author:              polyresolver team
maintainer:          team@polyresolver.dev
category:            Network
cabal-version:       >= 1.2
build-type:          Simple

library
  exposed-modules:     Polyresolver.Adapter.Decentweb
  build-depends:       base, polyresolver-types, polyresolver-core, network >= 3.1 && < 3.3, bytestring, text, containers, mtl, http-client, http-client-tls, aeson
  hs-source-dirs:      src
  default-language:    Haskell2010
