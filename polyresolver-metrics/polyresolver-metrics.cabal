cabal-version: 2.4
name: polyresolver-metrics
version: 0.1.0.0
synopsis: Prometheus metrics integration
description: See the project README and the technical specification.
license: MPL-2.0
license-file: LICENSE
maintainer: polyresolver@nousresearch.com
category: Network
build-type: Simple

library
  exposed-modules: Polyresolver.Metrics
  hs-source-dirs: src
  default-language: Haskell2010
  build-depends:
      base >= 4.15 && < 5
    , polyresolver-types, prometheus-client, prometheus-metrics-ghc, wai-middleware-prometheus, text, time, http-types, warp, wai
  ghc-options: -Wall -Wcompat

executable metrics
  main-is: Main.hs
  hs-source-dirs: app
  default-language: Haskell2010
  build-depends:
      base >= 4.15 && < 5
    , polyresolver-metrics
  ghc-options: -Wall -threaded
