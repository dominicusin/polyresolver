name:                polyresolver-config
version:             0.1.0.0
synopsis:            Configuration management for polyresolver
description:         YAML-based configuration loading and validation
homepage:            https://github.com/polyresolver/polyresolver
license:             MIT
author:              polyresolver team
maintainer:          team@polyresolver.dev
category:            Network
cabal-version:       >= 1.8
build-type:          Simple

library
  exposed-modules:     Polyresolver.Config
  build-depends:       base, polyresolver-types, polyresolver-core, yaml >= 0.11.8 && < 0.12, aeson >= 2.0 && < 2.3, text, bytestring, containers, mtl, directory, filepath
  hs-source-dirs:      src
  default-language:    Haskell2010
