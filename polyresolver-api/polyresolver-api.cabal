cabal-version: 2.4
name: polyresolver-api
version: 0.1.0.0
synopsis: Servant backend API
description: See the project README and the technical specification.
license: MPL-2.0
license-file: LICENSE
maintainer: polyresolver@nousresearch.com
category: Network
build-type: Simple

library
  exposed-modules: Polyresolver.API
               , Polyresolver.API.Types
  hs-source-dirs: src
  default-language: Haskell2010
  build-depends:
      base >= 4.15 && < 5
    , polyresolver-types, polyresolver-core, servant, servant-server, wai, warp, aeson, text, time, http-types, http-client, bytestring
  ghc-options: -Wall -Wcompat

executable api
  main-is: Main.hs
  hs-source-dirs: app
  default-language: Haskell2010
  build-depends:
      base >= 4.15 && < 5
    , polyresolver-api
  ghc-options: -Wall -threaded
